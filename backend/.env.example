ASSEMBLYAI_API_KEY=your_assemblyai_key_here
# GROQ_API_KEY powers both the batch analysis pipeline (app/services/analyze.py)
# and the "Ask Voxera" assistant (app/services/ask.py / POST /api/ask).
GROQ_API_KEY=your_groq_key_here

# --- Auth (JWT) — see backend/app/auth.py ---
# JWT_SECRET_KEY: any long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
# MANAGER_PASSWORD_HASH: bcrypt hash of the manager password, e.g.
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
JWT_SECRET_KEY=change_me_to_a_long_random_string
MANAGER_USERNAME=manager
MANAGER_PASSWORD_HASH='$2b$12$replace_with_a_real_bcrypt_hash'
